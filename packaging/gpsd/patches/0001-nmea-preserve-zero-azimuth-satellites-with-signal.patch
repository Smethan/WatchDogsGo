Description: Preserve partial GSV sky views with absent azimuth and signal
 gpsd 3.25 rejects every completed GSV set whose parsed satellite azimuths
 are all zero.  Some receivers omit the azimuth field while still reporting
 signal strength.  Track that field distinction privately so those partial
 entries survive without accepting explicit-zero SiRFstarII hairballs or
 changing gpsd's established sky-view representation.
Author: WatchDogsGo Project
Forwarded: no
Last-Update: 2026-10-02

--- a/include/gpsd.h
+++ b/include/gpsd.h
@@ -620,6 +620,8 @@ struct gps_device_t {
         char last_gsv_talker;
         char end_gsv_talker;
         unsigned char last_gsv_sigid;           // NMEA 4.1
+        // true when the corresponding GSV azimuth field was empty
+        bool gsv_azimuth_unavailable[MAXCHANNELS];
         // GSA stuff
         bool seen_bdgsa;                        // BeiDou GSA
         bool seen_gagsa;                        // Galileo GSA
--- a/drivers/driver_nmea0183.c
+++ b/drivers/driver_nmea0183.c
@@ -2203,6 +2203,9 @@ static gps_mask_t processGSV(int count, char *field[],
                                        &sp->gnssid, &sp->svid);

         sp->elevation = (double)atoi(field[fldnum++]);
+        session->nmea.gsv_azimuth_unavailable[
+            session->gpsdata.satellites_visible] =
+                '\0' == field[fldnum][0];
         sp->azimuth = (double)atoi(field[fldnum++]);
         sp->ss = (double)atoi(field[fldnum++]);
         sp->used = false;
@@ -2292,10 +2295,16 @@ static gps_mask_t processGSV(int count, char *field[],
      * GSV packet with all the azimuth entries 0 (but nonzero
      * elevations).  This behavior was observed under SiRF firmware
      * revision 231.000.000_A2.
+     *
+     * An empty azimuth field is different from an explicit zero.  Some
+     * receivers report signal strength before they know azimuth; retain
+     * those partial entries when the same satellite has positive signal.
+     * Explicit zeroes still follow the original SiRFstarII rejection path.
      */
      for (n = 0; n < session->gpsdata.satellites_visible; n++) {
-        if (0 != session->gpsdata.skyview[n].azimuth) {
-            // odd?
+        if (0 != session->gpsdata.skyview[n].azimuth ||
+            (session->nmea.gsv_azimuth_unavailable[n] &&
+             0 < session->gpsdata.skyview[n].ss)) {
             goto sane;
         }
     }
